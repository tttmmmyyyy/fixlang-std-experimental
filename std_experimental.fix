// The module `Std.Experimental` contains additions to `Std` whose design is not settled yet.
// Anything here may change or be removed in any version. When its design settles, it moves into
// `Std`.
//
// `Slice` is a part of an array, and `StringSlice` is a part of a string. Taking one does not copy
// the elements:
//
// ```fix
// assert_eq(|_|"", [1, 2, 3, 4].get_slice(1, 3).to_array, [2, 3]);;
// assert_eq(|_|"", "abc,def".get_slice(4, 7).to_string, "def")
// ```
module Std.Experimental;

import Std::{
    loop, Array, Eq, Format, I64, Iterator, Monad, Option, String, ToString, U8, 
    Array::{
        @, @size, _check_range, _unsafe_copy_range_bounds_unchecked, _unsafe_grow_size, empty, 
        get_sub, to_iter
    }, 
    Format::{TextOut, write_text, TextOut::{@_bytes, _reserve_to_append}}, 
    Iterator::{Item, advance, joined_with, map, range, to_array}, LessThan::{max, min}, 
    LoopState::{break, continue}, Monad::{bind, pure}, 
    Option::{none, some}, String::{@size, get_bytes, get_sub, join}, ToString::to_string
};

// A part of an array: the elements from one index up to another. Taking a slice does not copy the
// elements.
//
// Create a slice with `Array::to_slice` or `Array::get_slice`. For a part of a string, use
// `StringSlice`.
//
// `to_string` and `format` write a slice the same way as an array: `[1, 2, 3]`.
//
// A slice keeps a reference to the array it was taken from. While the slice exists, modifying that array copies
// it.
type Slice a = struct {
    // The array the slice was taken from.
    _array : Array a,
    // The index of the first element. `0 <= _begin <= _end`.
    _begin : I64,
    // The index after the last element. `_end <= _array.@size`.
    _end : I64
};

namespace Array {
    // A slice of all the elements of `array`.
    //
    // # Parameters
    // * `array` - The array.
    to_slice : Array a -> Slice a = |array| (
        Slice { _array : array, _begin : 0, _end : array.@size }
    );

    // A slice of the elements of `array` from index `begin` up to index `end`. It is like
    // `get_sub`, but does not copy the elements.
    //
    // `begin` and `end` are clamped to `[0, array.@size]`. If `end <= begin`, the slice is empty.
    //
    // # Examples
    //
    // ```fix
    // assert_eq(|_|"", [1, 2, 3, 4].get_slice(1, 3).to_array, [2, 3])
    // ```
    //
    // # Parameters
    // * `begin` - The index of the first element.
    // * `end` - The index after the last element.
    // * `array` - The array.
    get_slice : I64 -> I64 -> Array a -> Slice a = |begin, end, array| (
        array.to_slice.get_slice(begin, end)
    );
}

namespace String {
    // A slice of all the bytes of `str`.
    //
    // # Parameters
    // * `str` - The string.
    to_slice : String -> StringSlice = |str| (
        StringSlice { _string : str, _begin : 0, _end : str.@size }
    );

    // A slice of the bytes of `str` from index `begin` up to index `end`. It is like `get_sub`, but
    // does not copy the bytes.
    //
    // `begin` and `end` are clamped to `[0, str.@size]`. If `end <= begin`, the slice is empty.
    //
    // # Examples
    //
    // ```fix
    // assert_eq(|_|"", "abc,def".get_slice(4, 7).to_string, "def")
    // ```
    //
    // # Parameters
    // * `begin` - The index of the first byte.
    // * `end` - The index after the last byte.
    // * `str` - The string.
    get_slice : I64 -> I64 -> String -> StringSlice = |begin, end, str| (
        str.to_slice.get_slice(begin, end)
    );
}

namespace Slice {
    // The element at index `i` of `slice`. Index 0 is the first element of the slice. The program
    // aborts if `i` is out of range.
    //
    // # Parameters
    // * `i` - The index.
    // * `slice` - The slice.
    @ : I64 -> Slice a -> a = |i, slice| (
        let i = Array::_check_range(i, slice.@size);
        slice.@_array.@(slice.@_begin + i)
    );

    // The number of elements of `slice`.
    //
    // # Parameters
    // * `slice` - The slice.
    @size : Slice a -> I64 = |slice| slice.@_end - slice.@_begin;

    // The whole array that `slice` was taken from. The elements of `slice` are the elements of
    // this array from index `@begin` up to index `@end`.
    //
    // # Parameters
    // * `slice` - The slice.
    @array : Slice a -> Array a = |slice| slice.@_array;

    // The index in `@array` of the first element of `slice`.
    //
    // # Parameters
    // * `slice` - The slice.
    @begin : Slice a -> I64 = |slice| slice.@_begin;

    // The index in `@array` after the last element of `slice`.
    //
    // # Parameters
    // * `slice` - The slice.
    @end : Slice a -> I64 = |slice| slice.@_end;

    // A slice of the elements of `slice` from index `begin` up to index `end`. Index 0 is the first
    // element of `slice`.
    //
    // `begin` and `end` are clamped to `[0, slice.@size]`. If `end <= begin`, the slice is empty.
    //
    // # Examples
    //
    // ```fix
    // let slice = [1, 2, 3, 4, 5].get_slice(1, 5);   // [2, 3, 4, 5]
    // assert_eq(|_|"", slice.get_slice(1, 3).to_array, [3, 4])
    // ```
    //
    // # Parameters
    // * `begin` - The index of the first element.
    // * `end` - The index after the last element.
    // * `slice` - The slice.
    get_slice : I64 -> I64 -> Slice a -> Slice a = |begin, end, slice| (
        let (begin, end) = _clamp_range(begin, end, slice.@size);
        slice.set__begin(slice.@_begin + begin).set__end(slice.@_begin + end)
    );

    // `begin` and `end` clamped to `[0, size]`, with `end` no less than `begin`.
    //
    // # Parameters
    // * `begin` - The index of the first element asked for.
    // * `end` - The index after the last element asked for.
    // * `size` - The number of elements there are.
    _clamp_range : I64 -> I64 -> I64 -> (I64, I64) = |begin, end, size| (
        let begin = min(max(begin, 0), size);
        (begin, min(max(end, begin), size))
    );

    // An iterator over the elements of `slice`.
    //
    // # Parameters
    // * `slice` - The slice.
    to_iter : [?it : Iterator, Item ?it = a] Slice a -> ?it = |slice| (
        let array = slice.@_array;
        range(slice.@_begin, slice.@_end).map(|i| array.@(i))
    );

    // Copies the elements of `slice` into a new array.
    //
    // # Parameters
    // * `slice` - The slice.
    to_array : Slice a -> Array a = |slice| slice.@_array.get_sub(slice.@_begin, slice.@_end);
}

// Writes a slice the same way as an array: `[1, 2, 3]`.
impl [a : ToString] Slice a : ToString {
    to_string = |slice| "[" + slice.to_iter.map(to_string).join(", ") + "]";
}

// Writes a slice the same way as an array: `[1, 2, 3]`.
impl [a : Format] Slice a : Format {
    write_text = |slice, out| out.write_text("[").bind(write_text(slice.to_iter.joined_with(", "))).bind(write_text("]"));
}

// Two slices are equal if they have equal elements in the same order.
impl [a : Eq] Slice a : Eq {
    eq = |lhs, rhs| (
        let size = lhs.@size;
        if size != rhs.@size { false };
        let (left, right) = (lhs.@_array, rhs.@_array);
        let (left_begin, right_begin) = (lhs.@_begin, rhs.@_begin);
        loop(0, |i|
            if i == size { break $ true };
            if left.@(left_begin + i) != right.@(right_begin + i) { break $ false };
            continue $ i + 1
        )
    );
}

// A part of a string: the bytes from one index up to another. Taking a string slice does not copy
// the bytes.
//
// Create a string slice with `String::to_slice` or `String::get_slice`.
//
// `to_string` and `format` write a string slice as its text:
//
// ```fix
// let slice = "abc,def".get_slice(4, 7);
// assert_eq(|_|"", slice.to_string, "def");;
// assert_eq(|_|"", "[{}]".format((slice.right_aligned_to(5),)), "[  def]")
// ```
//
// A string slice keeps a reference to the string it was taken from.
type StringSlice = struct {
    // The string the slice was taken from.
    _string : String,
    // The index of the first byte. `0 <= _begin <= _end`.
    _begin : I64,
    // The index after the last byte. `_end <= _string.@size`.
    _end : I64
};

namespace StringSlice {
    // The number of bytes of `slice`.
    //
    // # Parameters
    // * `slice` - The string slice.
    @size : StringSlice -> I64 = |slice| slice.@_end - slice.@_begin;

    // A slice of the bytes of `slice` from index `begin` up to index `end`. Index 0 is the first
    // byte of `slice`.
    //
    // `begin` and `end` are clamped to `[0, slice.@size]`. If `end <= begin`, the slice is empty.
    //
    // # Examples
    //
    // ```fix
    // let slice = "abc,def".get_slice(4, 7);   // def
    // assert_eq(|_|"", slice.get_slice(1, 3).to_string, "ef")
    // ```
    //
    // # Parameters
    // * `begin` - The index of the first byte.
    // * `end` - The index after the last byte.
    // * `slice` - The string slice.
    get_slice : I64 -> I64 -> StringSlice -> StringSlice = |begin, end, slice| (
        let (begin, end) = Slice::_clamp_range(begin, end, slice.@size);
        slice.set__begin(slice.@_begin + begin).set__end(slice.@_begin + end)
    );

    // The bytes of `slice` as a `Slice U8`. It does not copy the bytes.
    //
    // # Examples
    //
    // ```fix
    // assert_eq(|_|"", "abc,def".get_slice(4, 7).get_bytes.to_array, ['d', 'e', 'f'])
    // ```
    //
    // # Parameters
    // * `slice` - The string slice.
    get_bytes : StringSlice -> Slice U8 = |slice| (
        Slice { _array : slice.@_string.get_bytes, _begin : slice.@_begin, _end : slice.@_end }
    );
}

// Returns the text of the slice as a string.
impl StringSlice : ToString {
    to_string = |slice| (
        let string = slice.@_string;
        if slice.@_begin == 0 && slice.@_end == string.@size { string };
        string.get_sub(slice.@_begin, slice.@_end)
    );
}

// Writes the text of the slice.
impl StringSlice : Format {
    write_text = |slice, out| (
        let (begin, end) = (slice.@_begin, slice.@_end);
        let size = out.@_bytes.@size;
        // The added bytes are not initialized; the copy fills all of them.
        let bytes = out._reserve_to_append(end - begin)._unsafe_grow_size(size + end - begin);
        pure $ TextOut { _bytes : bytes._unsafe_copy_range_bounds_unchecked(slice.@_string.get_bytes, begin, end, size) }
    );
}

// Two string slices are equal if they have the same bytes.
impl StringSlice : Eq {
    eq = |lhs, rhs| lhs.get_bytes == rhs.get_bytes;
}
