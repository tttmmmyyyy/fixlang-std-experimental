// The module `Std.Experimental` contains additions to `Std` whose design is not settled yet.
// Anything here may change or be removed in any version. When its design settles, it moves into
// `Std`.
//
// `Format` and `FormatArgs` are implemented for tuples of up to 12 elements.
//
// `String::format` fills the placeholders `{}` of a template with values of any types that
// implement `Format`. A wrapper such as `with_precision` or `right_aligned_to` changes how a value
// is written, and one wrapper can wrap another:
//
// ```fix
// let name = "pi".left_aligned_to(4);
// let value = 3.14159.with_precision(2_U8).right_aligned_to(6);
// assert_eq(|_|"", "{}|{}".format((name, value)), "pi  |  3.14")
// ```
module Std.Experimental;

import Std::{
    loop, undefined, Array, Bool, F32, F64, I16, I32, I64, I8, IO, Iterator, Option, Ptr, Result, String, U16, U32, 
    U64, U8, 
    Array::{
        @, @capacity, @size, _check_range, _get_sub_size_with_length_and_additional_capacity, 
        _unsafe_grow_size, append, empty, get_sub, is_empty, mutate_elements, pop_back, 
        push_back, reserve, resize, set, truncate, unsafe_set_bounds_unchecked
    }, 
    I64::_sign_and_magnitude, Iterator::{Item, fold, map, range}, LessThan::{max, min}, LoopState::{break, continue}, 
    Option::{as_some, is_none}, Ptr::add_offset, Result::{as_err, as_ok, is_ok}, 
    String::{
        @size, _address_length, _decimal_integer_length, _unsafe_from_c_str, _write_address, 
        _write_decimal_integer, from_U8, 
        get_bytes
    }, 
    ToI64::i64, ToU64::u64, U8::bit_and
};

namespace String {
    // Replaces the placeholders `{}` in a template with values.
    //
    // Each `{}` is replaced with the text of the next value, as `Format` writes it. `{{` and `}}` are
    // written as `{` and `}`.
    //
    // Pass the values as a tuple. The values may have different types. Write `(x,)` for one value and
    // `()` for none.
    //
    // The program aborts if the number of placeholders differs from the number of values, or if the
    // template has a `{` or `}` that is not part of a placeholder or an escape.
    //
    // # Examples
    //
    // ```fix
    // assert_eq(|_|"", "{} + {} = {}".format((1, 2.5, "three")), "1 + 2.5 = three");;
    // assert_eq(|_|"", "x = {}".format((42,)), "x = 42");;
    // assert_eq(|_|"", "{{{}}}".format((1,)), "{1}")
    // ```
    //
    // # Parameters
    // * `values` - The values to write, in order.
    // * `template` - The template.
    format : [args : FormatArgs] args -> String -> String = |values, template| (
        let cursor = TemplateCursor {
            _template : template,
            _at : 0,
            _out : TextOut { _bytes : Array::empty(2 * template.@size) }
        };
        cursor.write_args(values)._finish
    );
}

namespace Format {
    // The text written so far. `Format::write_text` appends the text of a value to it.
    //
    // Text is only appended at the end. It never contains a null byte, because the text of a value
    // never does.
    type TextOut = struct { _bytes : Array U8 };
}

namespace Format::TextOut {
    // Appends the text that `write` writes to a pointer.
    //
    // `write` receives a pointer to `max_size` bytes at the end of `out`. It writes the text there,
    // followed by a null, and returns the length of the text without the null. The writers of the
    // Fix runtime, such as `fixruntime_f64_to_str_shortest`, work this way when called with
    // `FFI_CALL_IO`.
    //
    // # Parameters
    // * `max_size` - The number of bytes `write` may write, including the null.
    // * `write` - Writes the text to the given pointer.
    // * `out` - The text written so far.
    _write_to_ptr : I64 -> (Ptr -> IO I64) -> TextOut -> TextOut = |max_size, write, out| (
        let size = out.@_bytes.@size;
        // `_unsafe_grow_size` copies the array if it is shared, so `write` writes only to this
        // array. The added bytes are not initialized; `write` fills the ones that are kept.
        let bytes = out._reserve_to_append(max_size)._unsafe_grow_size(size + max_size);
        let (bytes, length) = bytes.mutate_elements(|ptr| write(ptr.add_offset(size)));
        TextOut { _bytes : bytes.truncate(size + length) }
    );

    // Appends the decimal text of the integer whose sign is `negative` and whose magnitude is
    // `magnitude`: `-` where `negative` is true, then the digits.
    //
    // # Parameters
    // * `negative` - Whether the integer is below zero.
    // * `magnitude` - The absolute value of the integer.
    // * `out` - The text written so far.
    _write_decimal_integer : Bool -> U64 -> TextOut -> TextOut = |negative, magnitude, out| (
        let length = String::_decimal_integer_length(negative, magnitude);
        let end = out.@_bytes.@size + length;
        // The added bytes are not initialized; `_write_decimal_integer` fills all of them.
        let bytes = out._reserve_to_append(length)._unsafe_grow_size(end);
        TextOut { _bytes : bytes._write_decimal_integer(end, negative, magnitude) }
    );

    // Appends the decimal text of `v`, with `-` before the digits where `v` is below zero.
    //
    // # Parameters
    // * `v` - The integer to write.
    // * `out` - The text written so far.
    _write_signed_decimal_integer : I64 -> TextOut -> TextOut = |v, out| (
        let (negative, magnitude) = v._sign_and_magnitude;
        out._write_decimal_integer(negative, magnitude)
    );

    // Appends the address `ptr` holds, as sixteen hexadecimal digits.
    //
    // # Parameters
    // * `ptr` - The pointer whose address is written.
    // * `out` - The text written so far.
    _write_address : Ptr -> TextOut -> TextOut = |ptr, out| (
        let end = out.@_bytes.@size + String::_address_length;
        // The added bytes are not initialized; `_write_address` fills all of them.
        let bytes = out._reserve_to_append(String::_address_length)._unsafe_grow_size(end);
        TextOut { _bytes : bytes._write_address(end - String::_address_length, ptr) }
    );

    // Appends `count` spaces. Nothing is appended if `count` is less than 1.
    //
    // # Parameters
    // * `count` - The number of spaces.
    // * `out` - The text written so far.
    _write_spaces : I64 -> TextOut -> TextOut = |count, out| (
        if count <= 0 { out };
        let size = out.@_bytes.@size;
        TextOut { _bytes : out._reserve_to_append(count).resize(size + count, ' ') }
    );

    // Makes room for `count` more bytes at the end of `out`, so that appending them does not
    // reallocate, and returns the bytes of `out`.
    //
    // If the capacity is too small, it grows to at least twice its current value, as in
    // `Array::push_back` and `Array::append`. So writing a long text in many small pieces
    // reallocates only a few times.
    //
    // # Parameters
    // * `count` - The number of bytes to be appended.
    // * `out` - The text written so far.
    _reserve_to_append : I64 -> TextOut -> Array U8 = |count, out| (
        let bytes = out.@_bytes;
        let size = bytes.@size + count;
        if size <= bytes.@capacity { bytes };
        bytes.reserve(max(size, 2 * bytes.@capacity))
    );

    // Counts the Unicode code points in the text of `out`, from byte `start` to the end.
    //
    // # Parameters
    // * `start` - The byte to start counting from. It must be the first byte of a code point.
    // * `out` - The text written so far.
    _count_code_points_from : I64 -> TextOut -> I64 = |start, out| (
        let bytes = out.@_bytes;
        // Count the bytes that start a code point: those that are not continuation bytes
        // `0b10xxxxxx`.
        range(start, bytes.@size).fold(0, |i, count|
            if bytes.@(i).bit_and(0xC0_U8) == 0x80_U8 { count };
            count + 1
        )
    );
}

// A type whose values `format` can write.
//
// If the type also implements `ToString`, `write_text` must write the same text as `to_string`.
//
// A type that implements `ToString` can implement `Format` in one line:
//
// ```fix
// # module DocTest;
// # import Std.Experimental;
// #
// # type Point = struct { x : I64, y : I64 };
// #
// # impl Point : ToString {
// #     to_string = |p| "(" + p.@x.to_string + ", " + p.@y.to_string + ")";
// # }
// #
// impl Point : Format {
//     write_text = |p, out| out.write_text(p.to_string);
// }
// #
// # main : IO () = assert_eq(|_|"", "{}".format((Point { x : 1, y : 2 },)), "(1, 2)");
// ```
//
// Writing each part directly is faster, because it creates no intermediate string:
//
// ```fix
// # module DocTest;
// # import Std.Experimental;
// #
// # type Point = struct { x : I64, y : I64 };
// #
// impl Point : Format {
//     write_text = |p, out| out.write_text("(").write_text(p.@x).write_text(", ").write_text(p.@y).write_text(")");
// }
// #
// # main : IO () = assert_eq(|_|"", "{}".format((Point { x : 1, y : 2 },)), "(1, 2)");
// ```
trait a : Format {
    // Appends the text of `value` to `out`.
    //
    // # Parameters
    // * `value` - The value to write.
    // * `out` - The text written so far.
    write_text : a -> TextOut -> TextOut;
}

// The values that `format` writes into a template: `()`, or a tuple of values whose types
// implement `Format`.
trait args : FormatArgs {
    // Writes each value into the next placeholder of the template, after the template text before
    // that placeholder.
    //
    // # Parameters
    // * `values` - The values.
    // * `cursor` - The template and how much of it has been written.
    write_args : args -> TemplateCursor -> TemplateCursor;
}

namespace FormatArgs {
    // A template that `format` is filling in: the template, the position up to which it has been
    // written, and the text written so far.
    type TemplateCursor = struct { _template : String, _at : I64, _out : TextOut };
}

namespace FormatArgs::TemplateCursor {
    // Writes the template text up to the next placeholder, then the text of `value` in place of the
    // placeholder.
    //
    // # Parameters
    // * `value` - The value to write in place of the placeholder.
    // * `cursor` - The template and how much of it has been written.
    _put_next : [a : Format] a -> TemplateCursor -> TemplateCursor = |value, cursor| (
        let TemplateCursor { _template : template, _at : at, _out : out } = cursor;
        let (at, out) = _write_literal(template, at, out);
        if at == template.@size {
            undefined("[Std.Experimental::format] The template has fewer placeholders than the values: \"" + template + "\"")
        };
        TemplateCursor { _template : template, _at : at + 2, _out : out.write_text(value) }
    );

    // Writes the rest of the template and returns the whole text.
    //
    // # Parameters
    // * `cursor` - The template and how much of it has been written.
    _finish : TemplateCursor -> String = |cursor| (
        let TemplateCursor { _template : template, _at : at, _out : out } = cursor;
        let (at, out) = _write_literal(template, at, out);
        if at < template.@size {
            undefined("[Std.Experimental::format] The template has more placeholders than the values: \"" + template + "\"")
        };
        // A `TextOut` contains no null byte, so the string ends at the null added here.
        String { _data : out.@_bytes.push_back('\0') }
    );

    // Writes the text of `template` from byte `at` up to the next placeholder or the end. Each escape
    // is written as the brace it stands for.
    //
    // Returns the position of the placeholder, or the size of `template` if there is none, together
    // with the text written.
    //
    // # Parameters
    // * `template` - The template.
    // * `at` - The byte to start from.
    // * `out` - The text written so far.
    _write_literal : String -> I64 -> TextOut -> (I64, TextOut) = |template, at, out| (
        let size = template.@size;
        if at == size { (at, out) };
        let bytes = template.get_bytes;
        // The text written is at most the rest of the template, so room for it is made once, and
        // each byte is written without checking the room. The room left over is cut off at the end.
        let start = out.@_bytes.@size;
        let room = size - at;
        let bytes_out = out._reserve_to_append(room)._unsafe_grow_size(start + room);
        let (at, end, bytes_out) = loop((at, start, bytes_out), |(i, j, bytes_out)|
            if i == size { break $ (i, j, bytes_out) };
            let c = bytes.@(i);
            if c != '{' && c != '}' { continue $ (i + 1, j + 1, bytes_out.unsafe_set_bounds_unchecked(j, c)) };
            // A brace is always followed by another byte, since `bytes` ends with a null.
            let d = bytes.@(i + 1);
            if c == '{' && d == '}' { break $ (i, j, bytes_out) };
            if c == d { continue $ (i + 2, j + 1, bytes_out.unsafe_set_bounds_unchecked(j, c)) };
            undefined("[Std.Experimental::format] The template has a \"" + String::from_U8(c) + "\" that is neither a placeholder nor an escape: \"" + template + "\"")
        );
        (at, TextOut { _bytes : bytes_out.truncate(end) })
    );
}

impl () : FormatArgs {
    write_args = |_, cursor| cursor;
}

// Writes `true` or `false`, as `to_string` does.
impl Bool : Format {
    write_text = |b, out| (
        if b { out.write_text("true") };
        out.write_text("false")
    );
}

impl String : Format {
    write_text = |s, out| (
        // `append` copies the bytes of `s`, so removing the null afterwards does not change `s`.
        TextOut { _bytes : out.@_bytes.append(s.get_bytes).pop_back }
    );
}

// Writes `()`, as `to_string` does.
impl () : Format {
    write_text = |_, out| out.write_text("()");
}

impl U8 : Format {
    write_text = |v, out| out._write_decimal_integer(false, v.u64);
}

impl I8 : Format {
    write_text = |v, out| out._write_signed_decimal_integer(v.i64);
}

impl U16 : Format {
    write_text = |v, out| out._write_decimal_integer(false, v.u64);
}

impl I16 : Format {
    write_text = |v, out| out._write_signed_decimal_integer(v.i64);
}

impl U32 : Format {
    write_text = |v, out| out._write_decimal_integer(false, v.u64);
}

impl I32 : Format {
    write_text = |v, out| out._write_signed_decimal_integer(v.i64);
}

impl U64 : Format {
    write_text = |v, out| out._write_decimal_integer(false, v);
}

impl I64 : Format {
    write_text = |v, out| out._write_signed_decimal_integer(v);
}

// Writes sixteen hexadecimal digits, as `to_string` does.
impl Ptr : Format {
    write_text = |v, out| out._write_address(v);
}

// Writes the shortest decimal text that reads back as the same number, as `to_string` does.
impl F32 : Format {
    // The size is the one `to_string` gives this C function.
    write_text = |v, out| out._write_to_ptr(17, |ptr| FFI_CALL_IO[I64 fixruntime_f32_to_str_shortest(Ptr, I64, F32), ptr, 17, v]);
}

// Writes the shortest decimal text that reads back as the same number, as `to_string` does.
impl F64 : Format {
    // The size is the one `to_string` gives this C function.
    write_text = |v, out| out._write_to_ptr(25, |ptr| FFI_CALL_IO[I64 fixruntime_f64_to_str_shortest(Ptr, I64, F64), ptr, 25, v]);
}

// Writes `some(x)` or `none()`, as `to_string` does.
impl [a : Format] Option a : Format {
    write_text = |opt, out| (
        if opt.is_none { out.write_text("none()") };
        out.write_text("some(").write_text(opt.as_some).write_text(")")
    );
}

// Writes `ok(x)` or `err(e)`, as `to_string` does.
impl [e : Format, a : Format] Result e a : Format {
    write_text = |res, out| (
        if res.is_ok { out.write_text("ok(").write_text(res.as_ok).write_text(")") };
        out.write_text("err(").write_text(res.as_err).write_text(")")
    );
}

// Writes the elements between `[` and `]`, separated by `, `, as `to_string` does.
impl [a : Format] Array a : Format {
    write_text = |arr, out| out.write_text("[").write_text(arr.with_separator(", ")).write_text("]");
}

namespace Format {
    // A floating-point number written with a fixed number of digits after the decimal point. Created by
    // `F32::with_precision` or `F64::with_precision`.
    type WithPrecision a = struct { _precision : U8, _value : a };
}

namespace F32 {
    // Wraps `v` so that `format` writes it with `precision` digits after the decimal point, as
    // `F32::to_string_precision` does.
    //
    // # Examples
    //
    // ```fix
    // assert_eq(|_|"", "{}".format((3.14159_F32.with_precision(2_U8),)), "3.14")
    // ```
    //
    // # Parameters
    // * `precision` - The number of digits after the decimal point.
    // * `v` - The number.
    with_precision : U8 -> F32 -> WithPrecision F32 = |precision, v| WithPrecision { _precision : precision, _value : v };
}

namespace F64 {
    // Wraps `v` so that `format` writes it with `precision` digits after the decimal point, as
    // `F64::to_string_precision` does.
    //
    // # Examples
    //
    // ```fix
    // assert_eq(|_|"", "{}".format((3.14159.with_precision(2_U8),)), "3.14")
    // ```
    //
    // # Parameters
    // * `precision` - The number of digits after the decimal point.
    // * `v` - The number.
    with_precision : U8 -> F64 -> WithPrecision F64 = |precision, v| WithPrecision { _precision : precision, _value : v };
}

impl WithPrecision F32 : Format {
    write_text = |w, out| (
        let precision = w.@_precision;
        let v = w.@_value;
        // The size is the one `F32::to_string_precision` gives this C function.
        let size = 42 + precision.i64;
        out._write_to_ptr(size, |ptr| FFI_CALL_IO[I64 fixruntime_f32_to_str_precision(Ptr, I64, F32, U8), ptr, size, v, precision])
    );
}

impl WithPrecision F64 : Format {
    write_text = |w, out| (
        let precision = w.@_precision;
        let v = w.@_value;
        // The size is the one `F64::to_string_precision` gives this C function.
        let size = 312 + precision.i64;
        out._write_to_ptr(size, |ptr| FFI_CALL_IO[I64 fixruntime_f64_to_str_precision(Ptr, I64, F64, U8), ptr, size, v, precision])
    );
}

namespace Format {
    // The elements of an array, written with a separator between them. Created by `with_separator`.
    type WithSeparator a = struct { _separator : String, _elements : Array a };
}

namespace Array {
    // Wraps `elements` so that `format` writes them with `separator` between them.
    //
    // # Examples
    //
    // ```fix
    // assert_eq(|_|"", "{}".format(([1, 2, 3].with_separator(", "),)), "1, 2, 3")
    // ```
    //
    // # Parameters
    // * `separator` - The text to write between two elements.
    // * `elements` - The elements.
    with_separator : String -> Array a -> WithSeparator a = |separator, elements| WithSeparator { _separator : separator, _elements : elements };
}

impl [a : Format] WithSeparator a : Format {
    write_text = |w, out| (
        let separator = w.@_separator;
        let elements = w.@_elements;
        if elements.is_empty { out };
        range(1, elements.@size).fold(out.write_text(elements.@(0)), |i, out|
            out.write_text(separator).write_text(elements.@(i))
        )
    );
}

namespace Format {
    // A value padded with spaces on the left to a width. Created by `right_aligned_to`.
    type RightAligned a = struct { _width : I64, _value : a };

    // Wraps `value` so that `format` pads its text with spaces on the left to `width` Unicode code
    // points. A text that already has `width` code points or more is written unchanged.
    //
    // # Examples
    //
    // ```fix
    // assert_eq(|_|"", "[{}]".format((42.right_aligned_to(5),)), "[   42]")
    // ```
    //
    // # Parameters
    // * `width` - The minimum width, in Unicode code points.
    // * `value` - The value to write.
    right_aligned_to : I64 -> a -> RightAligned a = |width, value| RightAligned { _width : width, _value : value };
}

impl [a : Format] RightAligned a : Format {
    write_text = |aligned, out| (
        let start = out.@_bytes.@size;
        let out = out.write_text(aligned.@_value);
        let padding = aligned.@_width - out._count_code_points_from(start);
        if padding <= 0 { out };
        // Move the text `padding` bytes to the right, starting from its last byte, and then fill the
        // gap with spaces.
        let bytes = out._write_spaces(padding).@_bytes;
        let end = bytes.@size - padding;
        let bytes = loop((end, bytes), |(i, bytes)|
            if i == start { break $ bytes };
            let i = i - 1;
            let c = bytes.@(i);
            continue $ (i, bytes.set(i + padding, c))
        );
        let bytes = range(start, start + padding).fold(bytes, |i, bytes| bytes.set(i, ' '));
        TextOut { _bytes : bytes }
    );
}

namespace Format {
    // A value padded with spaces on the right to a width. Created by `left_aligned_to`.
    type LeftAligned a = struct { _width : I64, _value : a };

    // Wraps `value` so that `format` pads its text with spaces on the right to `width` Unicode code
    // points. A text that already has `width` code points or more is written unchanged.
    //
    // # Examples
    //
    // ```fix
    // assert_eq(|_|"", "[{}]".format((42.left_aligned_to(5),)), "[42   ]")
    // ```
    //
    // # Parameters
    // * `width` - The minimum width, in Unicode code points.
    // * `value` - The value to write.
    left_aligned_to : I64 -> a -> LeftAligned a = |width, value| LeftAligned { _width : width, _value : value };
}

impl [a : Format] LeftAligned a : Format {
    write_text = |aligned, out| (
        let start = out.@_bytes.@size;
        let out = out.write_text(aligned.@_value);
        out._write_spaces(aligned.@_width - out._count_code_points_from(start))
    );
}

// BEGIN tuple implementations. Generated by `fix run -- gen-tuples` in `tools`.

impl [t0 : Format] (t0,) : Format {
    write_text = |(x0,), out| out.write_text("(").write_text(x0).write_text(",)");
}

impl [t0 : Format] (t0,) : FormatArgs {
    write_args = |(x0,), cursor| cursor._put_next(x0);
}

impl [t0 : Format, t1 : Format] (t0, t1) : Format {
    write_text = |(x0, x1), out| out.write_text("(").write_text(x0).write_text(", ").write_text(x1).write_text(")");
}

impl [t0 : Format, t1 : Format] (t0, t1) : FormatArgs {
    write_args = |(x0, x1), cursor| cursor._put_next(x0)._put_next(x1);
}

impl [t0 : Format, t1 : Format, t2 : Format] (t0, t1, t2) : Format {
    write_text = |(x0, x1, x2), out| out.write_text("(").write_text(x0).write_text(", ").write_text(x1).write_text(", ").write_text(x2).write_text(")");
}

impl [t0 : Format, t1 : Format, t2 : Format] (t0, t1, t2) : FormatArgs {
    write_args = |(x0, x1, x2), cursor| cursor._put_next(x0)._put_next(x1)._put_next(x2);
}

impl [t0 : Format, t1 : Format, t2 : Format, t3 : Format] (t0, t1, t2, t3) : Format {
    write_text = |(x0, x1, x2, x3), out| out.write_text("(").write_text(x0).write_text(", ").write_text(x1).write_text(", ").write_text(x2).write_text(", ").write_text(x3).write_text(")");
}

impl [t0 : Format, t1 : Format, t2 : Format, t3 : Format] (t0, t1, t2, t3) : FormatArgs {
