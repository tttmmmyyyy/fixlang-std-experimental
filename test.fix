module Test;

import Std::{
    Array, Format, I64, IO, Identity, String, ToString, 
    Array::{@, @size, borrow_elements, to_iter}, Debug::assert_eq, Format::{right_aligned_to, left_aligned_to, write_text}, 
    Iterator::{fold, joined_with, range, to_array}, Monad::{bind, pure}, String::{@size, format, get_bytes, get_sub}, 
    ToString::to_string
};
import Std.Experimental::{
    Array::{get_slice, to_slice}, Slice::{@, @array, @begin, @end, @size, get_slice, to_array, to_iter}, 
    String::{get_slice, to_slice}, StringSlice::{@size, get_bytes, get_slice}
};

test : IO () = (
    test_slice_ranges;;
    test_slice_reads;;
    test_slice_traits;;
    test_string_slice;;
    test_string_slice_traits;;
    test_same_text_as_to_string;;
    test_shared_out;;
    pure()
);

// Tests that a slice covers the elements it is asked for: `get_slice` clamps its bounds as
// `get_sub` does, and a slice taken of a slice counts from the beginning of the slice.
test_slice_ranges : IO () = (
    let array = [10, 11, 12, 13, 14];
    assert_eq(|_|"whole", array.to_slice.to_array, array);;
    assert_eq(|_|"inside", array.get_slice(1, 4).to_array, [11, 12, 13]);;
    assert_eq(|_|"negative begin", array.get_slice(-2, 2).to_array, [10, 11]);;
    assert_eq(|_|"end past the size", array.get_slice(3, 9).to_array, [13, 14]);;
    assert_eq(|_|"end before begin", array.get_slice(3, 1).@size, 0);;
    assert_eq(|_|"begin past the size", array.get_slice(7, 9).@size, 0);;
    let inner = array.get_slice(1, 4).get_slice(1, 5);
    assert_eq(|_|"slice of a slice", inner.to_array, [12, 13]);;
    assert_eq(|_|"slice of a slice: begin", inner.@begin, 2);;
    assert_eq(|_|"slice of a slice: end", inner.@end, 4);;
    let before = array.get_slice(1, 4).get_slice(-3, 1);
    assert_eq(|_|"slice of a slice before its beginning", before.to_array, [11]);;
    pure()
);

// Tests the ways of reading a slice: an element by its index in the slice, the size, the elements
// in order, and the array the slice was taken from.
test_slice_reads : IO () = (
    let array = [10, 11, 12, 13, 14];
    let slice = array.get_slice(2, 5);
    assert_eq(|_|"first element", slice.@(0), 12);;
    assert_eq(|_|"last element", slice.@(2), 14);;
    assert_eq(|_|"size", slice.@size, 3);;
    assert_eq(|_|"iterator", slice.to_iter.to_array, [12, 13, 14]);;
    assert_eq(|_|"array", slice.@array, array);;
    assert_eq(|_|"begin", slice.@begin, 2);;
    assert_eq(|_|"end", slice.@end, 5);;
    pure()
);

// Tests that a slice is written as an array is, by `to_string` and by `format`, with and without
// a separator of its own, and that two slices are equal when their elements are, wherever in their
// arrays they stand.
test_slice_traits : IO () = (
    let array = [10, 11, 12, 13, 14];
    let slice = array.get_slice(1, 4);
    assert_eq(|_|"to_string", slice.to_string, "[11, 12, 13]");;
    assert_eq(|_|"to_string: empty", array.get_slice(2, 2).to_string, "[]");;
    assert_eq(|_|"format", "{}".format((slice,)), "[11, 12, 13]");;
    assert_eq(|_|"format: empty", "{}".format((array.get_slice(2, 2),)), "[]");;
    assert_eq(|_|"format: one", "{}".format((array.get_slice(4, 5),)), "[14]");;
    assert_eq(|_|"joined_with", "{}".format((slice.to_iter.joined_with("-"),)), "11-12-13");;
    let none = array.get_slice(2, 2);
    assert_eq(|_|"joined_with: empty", "<{}>".format((none.to_iter.joined_with("-"),)), "<>");;
    let last = array.get_slice(4, 5);
    assert_eq(|_|"aligned", "[{}]".format((last.right_aligned_to(6),)), "[  [14]]");;
    assert_eq(|_|"equal", slice, [0, 11, 12, 13].get_slice(1, 4));;
    assert_eq(|_|"equal: another beginning", slice, [0, 0, 0, 11, 12, 13, 0].get_slice(3, 6));;
    assert_eq(|_|"equal: whole", [11, 12, 13].to_slice, slice);;
    assert_eq(|_|"equal: different element", slice == [11, 12, 14].to_slice, false);;
    assert_eq(|_|"equal: different size", slice == array.get_slice(1, 3), false);;
    assert_eq(|_|"equal: empty", array.get_slice(0, 0), array.get_slice(5, 5));;
    pure()
);

// Tests that a string's slice covers the bytes it is asked for, without the null byte that ends
// the string and without a copy: `get_slice` clamps its bounds as `get_sub` does, and a slice
// taken of a slice counts from the beginning of the slice.
test_string_slice : IO () = (
    let str = "abc,def";
    let slice = str.to_slice;
    assert_eq(|_|"whole: size", slice.@size, 7);;
    assert_eq(|_|"whole: last byte", slice.get_bytes.@(6), 'f');;
    assert_eq(|_|"whole: no copy",
        slice.get_bytes.@array.borrow_elements(|p| p), str.get_bytes.borrow_elements(|p| p));;
    assert_eq(|_|"inside", str.get_slice(4, 7).to_string, "def");;
    assert_eq(|_|"inside: size", str.get_slice(4, 7).@size, 3);;
    assert_eq(|_|"negative begin", str.get_slice(-2, 2).to_string, "ab");;
    assert_eq(|_|"end past the size", str.get_slice(4, 20).to_string, "def");;
    assert_eq(|_|"end before begin", str.get_slice(3, 1).to_string, "");;
    assert_eq(|_|"begin past the size", str.get_slice(9, 12).@size, 0);;
    assert_eq(|_|"slice of a slice", str.get_slice(1, 6).get_slice(1, 9).to_string, "c,de");;
    let before = str.get_slice(1, 6).get_slice(-3, 1);
    assert_eq(|_|"slice of a slice before its beginning", before.to_string, "b");;
    assert_eq(|_|"bytes", str.get_slice(4, 7).get_bytes.to_array, ['d', 'e', 'f']);;
    assert_eq(|_|"bytes: begin", str.get_slice(4, 7).get_bytes.@begin, 4);;
    pure()
);

// Tests that a string slice is written as the text it holds, by `to_string` and by `format`, that
// the slice of a whole string gives that string without a copy, and that two string slices are
// equal when their bytes are, wherever in their strings they stand.
test_string_slice_traits : IO () = (
    let str = "abc,déf";
    assert_eq(|_|"to_string: whole", str.to_slice.to_string, str);;
    let whole = str.to_slice.to_string;
    assert_eq(|_|"to_string: whole, no copy",
        whole.get_bytes.borrow_elements(|p| p), str.get_bytes.borrow_elements(|p| p));;
    assert_eq(|_|"to_string: empty", str.get_slice(2, 2).to_string, "");;
    let (abc, def) = (str.get_slice(0, 3), str.get_slice(4, 8));
    assert_eq(|_|"format", "<{}|{}>".format((abc, def)), "<abc|déf>");;
    assert_eq(|_|"format: empty", "<{}>".format((str.get_slice(2, 2),)), "<>");;
    assert_eq(|_|"format: twice", "{}{}".format((abc, abc)), "abcabc");;
    let long = range(0, 1000).fold("", |i, text| text + i.to_string);
    let stretch = long.get_slice(10, 2000);
    assert_eq(|_|"format: long", "{}".format((stretch,)), long.get_sub(10, 2000));;
    assert_eq(|_|"right aligned", "[{}]".format((def.right_aligned_to(5),)), "[  déf]");;
    assert_eq(|_|"left aligned", "[{}]".format((def.left_aligned_to(5),)), "[déf  ]");;
    assert_eq(|_|"in an array", "{}".format(([abc, def],)), "[abc, déf]");;
    assert_eq(|_|"equal", str.get_slice(0, 3), "xabc".get_slice(1, 4));;
    assert_eq(|_|"equal: different byte", str.get_slice(0, 3) == "abd".to_slice, false);;
    assert_eq(|_|"equal: different size", str.get_slice(0, 3) == str.get_slice(0, 2), false);;
    pure()
);

// Checks that `format` writes `x` as `to_string` does, alone and after other text.
//
// # Parameters
// * `name` - The name of the case, shown when the check fails.
// * `x` - The value to write.
check_to_string : [a : Format, a : ToString] String -> a -> IO () = |name, x| (
    assert_eq(|_|name + " alone", "{}".format((x,)), x.to_string);;
    assert_eq(|_|name + " after text", "ab{}cd".format((x,)), "ab" + x.to_string + "cd")
);

// Tests that `format` writes a slice and a string slice as `to_string` does.
test_same_text_as_to_string : IO () = (
    check_to_string("empty slice", [1, 2, 3].get_slice(1, 1));;
    check_to_string("slice", [1, 2, 3, 4].get_slice(1, 3));;
    check_to_string("slice of bytes", "abc".get_slice(0, 2).get_bytes);;
    check_to_string("empty string slice", "Hello, 世界".get_slice(3, 3));;
    check_to_string("string slice", "Hello, 世界".get_slice(4, 10));;
    check_to_string("whole string slice", "Hello, 世界".to_slice);;
    pure()
);

type TwoTries a = struct { value : a };

// Writes the value to `out` twice, keeps the second result and drops the first. So `out` is shared
// when the second write starts.
impl [a : Format] TwoTries a : Format {
    write_text = |t, out| (
        let Identity { data : first } = out.write_text(t.@value).bind(write_text(" first"));
        let second = out.write_text(t.@value).bind(write_text(" second"));
        eval first;
        second
    );
}

// Tests that a shared `TextOut` is copied before a string slice is written to it, so each copy has
// only its own text.
test_shared_out : IO () = (
    let slice = "abc,def".get_slice(4, 7);
    assert_eq(|_|"shared string slice", "[{}]".format((TwoTries { value : slice },)), "[def second]");;
    pure()
);
